<?xml version="1.0"?>
<!-- =========================================================================
     AMR-X  -  Sensor links (physical placement)
     LiDAR + IMU links and joints. The actual Gazebo <sensor> definitions that
     make them publish data live in amr_gazebo.xacro. Wheel encoders are not a
     physical link: they are produced by the diff-drive plugin odometry.
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====================================================================
       2D LiDAR  (top-front mounted scanner)
       ==================================================================== -->
  <xacro:if value="${lidar_enabled}">
    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_link"/>
      <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
    </joint>

    <link name="lidar_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
        </geometry>
        <material name="amr_dark_grey"/>
      </visual>
      <!-- small visual cap so the scanner reads as a real device in demos -->
      <visual>
        <origin xyz="0 0 ${lidar_height/2.0 + 0.004}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_radius*0.6}" length="0.008"/>
        </geometry>
        <material name="amr_sensor_green"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="${lidar_mass}"
                               radius="${lidar_radius}" length="${lidar_height}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>
  </xacro:if>

  <!-- ====================================================================
       IMU  (mounted near centre of mass)
       ==================================================================== -->
  <xacro:if value="${imu_enabled}">
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
    </joint>

    <link name="imu_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${imu_size} ${imu_size} ${imu_size*0.4}"/>
        </geometry>
        <material name="amr_warning_yellow"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${imu_size} ${imu_size} ${imu_size*0.4}"/>
        </geometry>
      </collision>
      <xacro:inertial_box mass="${imu_mass}"
                          x="${imu_size}" y="${imu_size}" z="${imu_size*0.4}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>
  </xacro:if>

</robot>
