<?xml version="1.0"?>
<!-- =========================================================================
     amr_2lidar.urdf.xacro  -  wraps the NEW SolidWorks CAD export
     (AMR-2Lidar-Link.urdf) which contains the updated chassis AND both
     LiDAR links, and adds everything Nav2 / Gazebo Harmonic need but the
     CAD file lacks:
       - base_footprint frame (Nav2 / SLAM ground reference)
       - differential-drive plugin pointed at the REAL wheels (DL_joint/DR_joint)
       - joint-state + sensors system plugins
       - TWO LiDAR sensors (Lidar1_link, Lidar2_link) + IMU
       - zero-friction casters

     Build:  xacro amr_2lidar.urdf.xacro > amr_2lidar.urdf
     ========================================================================= -->
<robot name="amr_x_2lidar" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================================
       >>> VERIFY THESE AGAINST THE NEW CAD / REAL ROBOT <<<
       =================================================================== -->
  <xacro:property name="wheel_radius"     value="0.080"/>   <!-- VERIFY: not derivable from the CAD export -->
  <xacro:property name="wheel_separation" value="0.541"/>  <!-- from DL/DR joint origins (2 x 0.289353) -->
  <xacro:property name="base_to_axle_z"   value="0.3305"/>  <!-- NEW CAD: DL/DR joint z = -0.3305 (was 0.3505) -->

  <!-- IMU mount point on base_link -->
  <xacro:property name="imu_xyz" value="0 0 0.0"/>

  <!-- LiDAR topics.
       Lidar1 keeps the name 'scan' so the existing Nav2 / SLAM stack, which
       subscribes to /scan, keeps working unchanged.
       Lidar2 publishes separately on 'scan_2' for your friend's tests.
       When you add a scan merger later: retopic Lidar1 to 'scan_1', merge
       scan_1 + scan_2, and publish the merged result as /scan. -->
  <xacro:property name="lidar1_topic" value="scan"/>
  <xacro:property name="lidar2_topic" value="scan_2"/>

  <!-- LiDAR sensor characteristics (shared by both units) -->
  <xacro:property name="lidar_min_range"    value="0.15"/>
  <xacro:property name="lidar_max_range"    value="12.0"/>
  <xacro:property name="lidar_samples"      value="360"/>
  <xacro:property name="lidar_update_rate"  value="10"/>

  <!-- ===================================================================
       1. Pull in the NEW CAD export (chassis + casters + drive wheels +
          Lidar1_link + Lidar2_link, all with meshes)
       =================================================================== -->
  <xacro:include filename="$(find robot_description)/urdf/AMR-2Lidar-Link.urdf"/>

  <!-- ===================================================================
       2. base_footprint : ground-projected frame under base_link.
          base_link sits (base_to_axle_z) above the axle, and the wheel
          contacts the floor one wheel_radius below the axle, so the floor
          is (base_to_axle_z + wheel_radius) below base_link.
       =================================================================== -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${base_to_axle_z + wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================
       3. IMU frame (the two LiDAR frames already come from the CAD)
       =================================================================== -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="${imu_xyz}" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================================
       4. Gazebo Harmonic system plugins
       =================================================================== -->
  <gazebo>
    <!-- Differential drive on the REAL wheels -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>DL_joint</left_joint>
      <right_joint>DR_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>1.2</max_linear_velocity>
      <min_linear_velocity>-1.2</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <!-- ===================================================================
       5a. LIDAR 1  ->  attached to the CAD's Lidar1_link, publishes /scan
       =================================================================== -->
  <gazebo reference="Lidar1_link">
    <sensor name="lidar1" type="gpu_lidar">
      <topic>${lidar1_topic}</topic>
      <gz_frame_id>Lidar1_link</gz_frame_id>
      <update_rate>${lidar_update_rate}</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${lidar_min_range}</min>
          <max>${lidar_max_range}</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===================================================================
       5b. LIDAR 2  ->  attached to the CAD's Lidar2_link, publishes /scan_2
       =================================================================== -->
  <gazebo reference="Lidar2_link">
    <sensor name="lidar2" type="gpu_lidar">
      <topic>${lidar2_topic}</topic>
      <gz_frame_id>Lidar2_link</gz_frame_id>
      <update_rate>${lidar_update_rate}</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${lidar_min_range}</min>
          <max>${lidar_max_range}</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===================================================================
       6. IMU sensor
       =================================================================== -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <!-- ===================================================================
       7. Zero-friction casters (passive: must not fight the drive)
       =================================================================== -->
  <gazebo reference="FR_Caster_Wheel_Link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="FL_Caster_Wheel_Link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="BR_Caster_Wheel_Link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="BL_Caster_Wheel_Link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

</robot>
