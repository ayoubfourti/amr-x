<?xml version="1.0"?>
<!-- =========================================================================
     AMR-X  -  Core mobile base
     Differential drive: 2 powered wheels (left/right) + 2 passive casters.
     All geometry is parameterised from config/robot_params.yaml.
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====================================================================
       base_footprint : ground-projected origin used by Nav2 / SLAM.
       Sits on the floor (z=0) directly under the robot centre.
       ==================================================================== -->
  <link name="base_footprint"/>

  <!-- ====================================================================
       base_link : main chassis body.
       Placed so its centre is at axle height + configured offset.
       ==================================================================== -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- lift base_link up to the wheel axle line + chassis offset -->
    <origin xyz="0 0 ${wheel_radius + chassis_z_offset}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="amr_body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}"
                        x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
      <origin xyz="0 0 ${chassis_height/2.0}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- A thin top plate (visual only) for a finished look in demos -->
  <joint name="top_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_plate_link"/>
    <origin xyz="0 0 ${chassis_height}" rpy="0 0 0"/>
  </joint>
  <link name="top_plate_link">
    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length*0.98} ${chassis_width*0.98} 0.010"/>
      </geometry>
      <material name="amr_light_grey"/>
    </visual>
  </link>

  <!-- ====================================================================
       Drive wheel macro (left / right)
       reflect = +1 for left (+Y), -1 for right (-Y)

       The drive wheel joints attach to base_link, whose origin is raised by
       (wheel_radius + chassis_z_offset). To place the wheel centre exactly on
       the axle line we drop it back down by chassis_z_offset.
       ==================================================================== -->
  <xacro:macro name="drive_wheel_positioned" params="prefix reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_x_offset} ${reflect * (wheel_separation/2.0)} ${-chassis_z_offset}"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.1"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="amr_wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}"
                               radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      </xacro:inertial_cylinder>
    </link>
  </xacro:macro>

  <xacro:drive_wheel_positioned prefix="left"  reflect="1"/>
  <xacro:drive_wheel_positioned prefix="right" reflect="-1"/>

  <!-- ====================================================================
       Passive caster macro (front / rear), modelled as a low-friction sphere
       ==================================================================== -->
  <xacro:macro name="caster_wheel" params="prefix x_sign">
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_link"/>
      <!-- drop the caster so its bottom touches the floor:
           base_link sits at wheel_radius+offset; caster bottom must reach z=0 -->
      <origin xyz="${x_sign * caster_x_offset} 0 ${-(wheel_radius + chassis_z_offset) + caster_radius}"
              rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_caster_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="amr_dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_sphere>
    </link>
  </xacro:macro>

  <xacro:caster_wheel prefix="front" x_sign="1"/>
  <xacro:caster_wheel prefix="rear"  x_sign="-1"/>

</robot>
