<?xml version="1.0"?>
<!-- =========================================================================
     AMR-X  =  Gazebo integration
     Default stack: ROS 2 Jazzy + Gazebo Harmonic + ros_gz.
     Compatibility stack: ROS 2 Humble + Gazebo Fortress + ros_gz.

     = DiffDrive system  : differential drive + wheel-encoder odometry
     = JointStatePublisher system : publishes joint states
     = Sensors system    : runs the LiDAR + IMU sensors
     = Per-link <sensor> tags for the 2D LiDAR and the IMU

     The simulator_variant argument selects the plugin filenames, plugin
     namespaces, and sensor frame tags for either Harmonic or Fortress.
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="simulator_variant" default="harmonic"/>
  <xacro:property name="sim_variant" value="$(arg simulator_variant)"/>

  <!-- ====================================================================
       Differential drive controller + odometry (simulated wheel encoders)
       Publishes odom on /odom and the odom=>base_footprint TF on /tf.
       Subscribes to /cmd_vel for teleop / Nav2.
       ==================================================================== -->
  <gazebo>
    <xacro:if value="${sim_variant == 'harmonic'}">
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <!-- joints -->
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>

        <!-- kinematics (from robot_params.yaml) -->
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>

        <!-- limits -->
        <max_linear_velocity>${drive_max_linear_velocity}</max_linear_velocity>
        <min_linear_velocity>${-drive_max_linear_velocity}</min_linear_velocity>
        <max_angular_velocity>${drive_max_angular_velocity}</max_angular_velocity>
        <min_angular_velocity>${-drive_max_angular_velocity}</min_angular_velocity>
        <max_linear_acceleration>${drive_max_linear_accel}</max_linear_acceleration>
        <min_linear_acceleration>${-drive_max_linear_accel}</min_linear_acceleration>
        <max_angular_acceleration>${drive_max_angular_accel}</max_angular_acceleration>
        <min_angular_acceleration>${-drive_max_angular_accel}</min_angular_acceleration>

        <!-- topics & frames -->
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>${encoders_publish_rate}</odom_publish_frequency>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
      </plugin>

      <plugin filename="gz-sim-sensors-system"
              name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </xacro:if>

    <xacro:unless value="${sim_variant == 'harmonic'}">
      <plugin filename="libignition-gazebo-diff-drive-system.so"
              name="ignition::gazebo::systems::DiffDrive">
        <!-- joints -->
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>

        <!-- kinematics (from robot_params.yaml) -->
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>

        <!-- limits -->
        <max_linear_velocity>${drive_max_linear_velocity}</max_linear_velocity>
        <min_linear_velocity>${-drive_max_linear_velocity}</min_linear_velocity>
        <max_angular_velocity>${drive_max_angular_velocity}</max_angular_velocity>
        <min_angular_velocity>${-drive_max_angular_velocity}</min_angular_velocity>
        <max_linear_acceleration>${drive_max_linear_accel}</max_linear_acceleration>
        <min_linear_acceleration>${-drive_max_linear_accel}</min_linear_acceleration>
        <max_angular_acceleration>${drive_max_angular_accel}</max_angular_acceleration>
        <min_angular_acceleration>${-drive_max_angular_accel}</min_angular_acceleration>

        <!-- topics & frames -->
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>${encoders_publish_rate}</odom_publish_frequency>
      </plugin>

      <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
              name="ignition::gazebo::systems::JointStatePublisher">
        <topic>joint_states</topic>
      </plugin>

      <plugin filename="libignition-gazebo-sensors-system.so"
              name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </xacro:unless>
  </gazebo>

  <!-- ====================================================================
       LiDAR sensor (gpu_lidar) attached to lidar_link
       ==================================================================== -->
  <xacro:if value="${lidar_enabled}">
    <xacro:if value="${sim_variant == 'harmonic'}">
      <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
          <topic>scan</topic>
          <gz_frame_id>lidar_link</gz_frame_id>
          <update_rate>${lidar_update_rate}</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>${lidar_samples}</samples>
                <resolution>1</resolution>
                <min_angle>${lidar_min_angle}</min_angle>
                <max_angle>${lidar_max_angle}</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>${lidar_min_range}</min>
              <max>${lidar_max_range}</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>${lidar_noise_stddev}</stddev>
            </noise>
          </lidar>
        </sensor>
      </gazebo>
    </xacro:if>
    <xacro:unless value="${sim_variant == 'harmonic'}">
      <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
          <topic>scan</topic>
          <ignition_frame_id>lidar_link</ignition_frame_id>
          <update_rate>${lidar_update_rate}</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>${lidar_samples}</samples>
                <resolution>1</resolution>
                <min_angle>${lidar_min_angle}</min_angle>
                <max_angle>${lidar_max_angle}</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>${lidar_min_range}</min>
              <max>${lidar_max_range}</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>${lidar_noise_stddev}</stddev>
            </noise>
          </lidar>
        </sensor>
      </gazebo>
    </xacro:unless>
  </xacro:if>

  <!-- ====================================================================
       IMU sensor attached to imu_link
       ==================================================================== -->
  <xacro:if value="${imu_enabled}">
    <xacro:if value="${sim_variant == 'harmonic'}">
      <gazebo reference="imu_link">
        <sensor name="imu" type="imu">
          <topic>imu</topic>
          <gz_frame_id>imu_link</gz_frame_id>
          <update_rate>${imu_update_rate}</update_rate>
          <always_on>true</always_on>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise_stddev}</stddev>
                <bias_mean>0.0</bias_mean><bias_stddev>${imu_gyro_bias_stddev}</bias_stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise_stddev}</stddev>
                <bias_mean>0.0</bias_mean><bias_stddev>${imu_gyro_bias_stddev}</bias_stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise_stddev}</stddev>
                <bias_mean>0.0</bias_mean><bias_stddev>${imu_gyro_bias_stddev}</bias_stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise_stddev}</stddev>
                <bias_mean>0.0</bias_mean><bias_stddev>${imu_accel_bias_stddev}</bias_stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise_stddev}</stddev>
                <bias_mean>0.0</bias_mean><bias_stddev>${imu_accel_bias_stddev}</bias_stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise_stddev}</stddev>
                <bias_mean>0.0</bias_mean><bias_stddev>${imu_accel_bias_stddev}</bias_stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </gazebo>
    </xacro:if>
    <xacro:unless value="${sim_variant == 'harmonic'}">
      <gazebo reference="imu_link">
        <sensor name="imu" type="imu">
          <topic>imu</topic>
          <ignition_frame_id>imu_link</ignition_frame_id>
          <update_rate>${imu_update_rate}</update_rate>
          <always_on>true</always_on>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise_stddev}</stddev>
                <bias_mean>0.0</bias_mean><bias_stddev>${imu_gyro_bias_stddev}</bias_stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise_stddev}</stddev>
                <bias_mean>0.0</bias_mean><bias_stddev>${imu_gyro_bias_stddev}</bias_stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise_stddev}</stddev>
                <bias_mean>0.0</bias_mean><bias_stddev>${imu_gyro_bias_stddev}</bias_stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise_stddev}</stddev>
                <bias_mean>0.0</bias_mean><bias_stddev>${imu_accel_bias_stddev}</bias_stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise_stddev}</stddev>
                <bias_mean>0.0</bias_mean><bias_stddev>${imu_accel_bias_stddev}</bias_stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise_stddev}</stddev>
                <bias_mean>0.0</bias_mean><bias_stddev>${imu_accel_bias_stddev}</bias_stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </gazebo>
    </xacro:unless>
  </xacro:if>

  <!-- ====================================================================
       Visual material hints + caster friction for Gazebo
       ==================================================================== -->
  <gazebo reference="base_link">
    <material>
      <ambient>0.10 0.35 0.65 1.0</ambient>
      <diffuse>0.10 0.35 0.65 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="left_wheel_link"><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></gazebo>
  <gazebo reference="right_wheel_link"><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></gazebo>
  <gazebo reference="front_caster_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="rear_caster_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

</robot>
