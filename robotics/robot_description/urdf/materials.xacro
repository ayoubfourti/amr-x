<?xml version="1.0"?>
<!-- =========================================================================
     AMR-X  -  Material / colour definitions (RViz + Gazebo visual)
     A clean, professional palette for client demonstrations.
     ========================================================================= -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="amr_body_blue">
    <color rgba="0.10 0.35 0.65 1.0"/>
  </material>

  <material name="amr_dark_grey">
    <color rgba="0.20 0.20 0.22 1.0"/>
  </material>

  <material name="amr_light_grey">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>

  <material name="amr_wheel_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="amr_sensor_green">
    <color rgba="0.10 0.70 0.30 1.0"/>
  </material>

  <material name="amr_warning_yellow">
    <color rgba="0.95 0.80 0.10 1.0"/>
  </material>

  <material name="amr_white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>

</robot>
